{
  "name": "epics-katalog",
  "version": "0.1.0",
  "private": true,
  "description": "Öffentlicher Bildkatalog der ETH-Bibliothek (E-Pics) – Web Components auf Basis der Sharedien REST API",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:themes && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check:themes": "node --experimental-strip-types scripts/check-themes.ts"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.15.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lit/context": "1.1.6",
    "lit": "3.3.3",
    "lucide": "1.77.0",
    "maplibre-gl": "6.19.0",
    "openseadragon": "6.1.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/openseadragon": "5.0.2",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
